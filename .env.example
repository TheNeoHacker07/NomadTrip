# Public origin used for sitemap, robots, canonical and Open Graph URLs
SITE_URL=http://localhost:3000

# Number of trusted reverse proxies in front of the app; the n-th x-forwarded-for entry from the right is the client IP.
# Leave unset when not behind a proxy: per-IP rate limits are then skipped (never trust the header blindly).
TRUST_PROXY_HOPS=
